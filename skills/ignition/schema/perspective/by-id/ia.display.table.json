        "number": {
         "description": "Number type column filter.",
         "properties": {
          "condition": {
           "type": "string",
           "description": "Filter condition.  Note: if a \"between\" condition is selected, the value must be a an object containing properties \"min\" and \"max\" .",
           "suggestions": {
            "(empty)": "",
            "greater than": "greater than",
            "greater than or equal to": "greater than or equal to",
            "less than": "less than",
            "less than or equal to": "less than or equal to",
            "equals": "equals",
            "between": "between"
