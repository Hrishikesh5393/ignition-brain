   "selection": {
    "type": "object",
    "description": "Table selection configuration and data.",
    "additionalProperties": false,
    "required": [
     "mode",
     "enableRowSelection",
     "enableColumnSelection",
     "selectedColumn",
     "selectedRow"
    ],
    "properties": {
     "mode": {
      "type": "string",
      "description": "This mode determines if only one row/cell/column can be selected at once, or single or multiple intervals.",
      "enum": [
       "single",
       "single interval",
       "multiple interval"
      ],
      "default": "single"
     },
     "enableRowSelection": {
      "type": "boolean",
      "description": "This flag is used in conjunction with the Column Selection Allowed flag to determine whether not whole-rows, whole-columns, or both (single-cells) are selectable.",
      "default": true
     },
     "enableColumnSelection": {
      "type": "boolean",
      "description": "This flag is used in conjunction with the Row Selection Allowed flag to determine whether not whole-rows, whole-columns, or both (single-cells) are selectable.",
      "default": false
     },
     "selectedColumn": {
      "type": [
       "string",
       "null"
      ],
      "description": "The index of the selected column, or null if none.",
      "default": null
     },
     "selectedRow": {
      "type": [
       "number",
       "null"
      ],
      "description": "The index of the selected row, or null if none.",
      "default": null
     },
     "data": {
      "type": "array",
      "description": "An array of objects representing the current selection.",
      "items": {
       "type": "object",
       "properties": {}
      },
      "default": []
     },
     "style": {
      "description": "Style to apply to the selected table values.",
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
     }
    }
