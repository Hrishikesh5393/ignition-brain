{
 "id": "ia.display.cylindrical-tank",
 "name": "Cylindrical Tank",
 "palette": {
  "category": "display",
  "variants": [
   {
    "label": "Cylindrical Tank",
    "tooltip": "Displays the volume level of a tank or vessel."
   }
  ]
 },
 "defaultMetaName": "CylindricalTank",
 "schema": {
  "type": "object",
  "properties": {
   "value": {
    "type": "number",
    "default": 0
   },
   "capacity": {
    "type": "number",
    "default": 100
   },
   "liquidColor": {
    "type": "string",
    "format": "color",
    "default": "",
    "description": "The color used to render the filled part of the tank."
   },
   "tankColor": {
    "type": "string",
    "format": "color",
    "default": ""
   },
   "liquidOpacity": {
    "type": "number",
    "minimum": 0,
    "maximum": 1,
    "default": 0.7
   },
   "liquidWarningColor": {
    "type": "string",
    "format": "color",
    "default": ""
   },
   "tankWarningColor": {
    "type": "string",
    "format": "color",
    "default": ""
   },
   "warningThreshold": {
    "type": "number",
    "default": 100,
    "description": "The warning appearance will be applied when value as a percentage of the capacity exceeds this value."
   },
   "strokeWidth": {
    "type": "number",
    "minimum": 0,
    "default": 2
   },
   "valueDisplay": {
    "type": "object",
    "properties": {
     "enabled": {
      "type": "boolean",
      "description": "If true, will show the value display overlay.",
      "default": true
     },
     "format": {
      "type": [
       "string",
       "number"
      ],
      "description": "Format to apply to value which is then used as the display value.",
      "suggestions": {
       "none": "none",
       "integer [1,200]": "0,0",
       "percent [10%]": "0%",
       "currency [$1,000.12]": "$0,0.00"
      },
      "default": "0%"
     },
     "unit": {
      "type": "object",
      "description": "Unit value to display on value overlay",
      "properties": {
       "enabled": {
        "type": "boolean",
        "default": false,
        "description": "If true, will show either a prefixed or postfixed unit"
       },
       "value": {
        "type": "string",
        "default": "",
        "description": "Unit value to display"
       },
       "fix": {
        "type": "string",
        "enum": [
         "pre",
         "post"
        ],
        "default": "post",
        "description": "Direction in which to place the unit. Either as a prefix or a postfix."
       }
      }
     },
     "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
     }
    }
   },
   "style": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
   }
  },
  "required": [
   "value",
   "capacity"
  ],
  "additionalProperties": false
 },
 "resources": [
  {
   "name": "perspective-components-css",
   "path": "/res/perspective/css/PerspectiveComponents.css",
   "type": "css"
  },
  {
   "name": "perspective-components-js",
   "path": "/res/perspective/js/PerspectiveComponents.js",
   "type": "js"
  }
 ]
}