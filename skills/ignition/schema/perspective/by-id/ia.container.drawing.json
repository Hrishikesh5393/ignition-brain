{
 "id": "ia.container.drawing",
 "palette": {
  "category": "container",
  "name": "Drawing",
  "description": "A vector drawing, symbol, schematic, or diagram that uses SVG format"
 },
 "defaultMetaName": "Drawing",
 "showOnPalette": false,
 "schema": {
  "type": "object",
  "properties": {
   "viewBox": {
    "type": "string",
    "default": "0 0 100 100"
   },
   "preserveAspectRatio": {
    "type": "string",
    "default": "xMidYMid",
    "enum": [
     "none",
     "xMinYMin",
     "xMidYMin",
     "xMaxYMin",
     "xMinYMid",
     "xMidYMid",
     "xMaxYMid",
     "xMinYMax",
     "xMidYMax",
     "xMaxYMax"
    ]
   },
   "style": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
   }
  }
 },
 "childPositionSchema": {
  "type": "object",
  "default": {}
 },
 "resources": [
  {
   "name": "perspective-components-css",
   "path": "/res/perspective/css/PerspectiveComponents.css",
   "type": "css"
  },
  {
   "name": "perspective-components-js",
   "path": "/res/perspective/js/PerspectiveComponents.js",
   "type": "js"
  }
 ]
}