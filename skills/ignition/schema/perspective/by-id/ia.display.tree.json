{
 "id": "ia.display.tree",
 "name": "Tree",
 "palette": {
  "category": "display",
  "variants": [
   {
    "label": "Tree",
    "tooltip": "Displays a dataset in a tree hierarchy."
   }
  ]
 },
 "defaultMetaName": "Tree",
 "schema": {
  "type": "object",
  "title": "Tree",
  "description": "An interactive tree component.",
  "additionalProperties": false,
  "properties": {
   "interactable": {
    "type": "boolean",
    "default": true,
    "description": "If false, tree is displayed but may not be interacted with."
   },
   "branchNodeSelectable": {
    "type": "boolean",
    "default": true,
    "description": "If false, only terminal nodes without children will be selectable."
   },
   "items": {
    "type": "array",
    "default": [],
    "description": "An array of objects, each representing a distinct node in the tree.",
    "items": {
     "type": "object",
     "$ref": "#/definitions/TreeNode"
    }
   },
   "selection": {
    "type": "array",
    "description": "Holds the item index paths of the current selection.",
    "default": [],
    "items": {
     "type": "string",
     "pattern": ""
    }
   },
   "selectionData": {
    "type": "array",
    "description": "Array of objects containing the data and index path for all currently selected items.",
    "default": [],
    "items": {
     "type": "object",
     "properties": {
      "itemPath": {
       "type": "string"
      },
      "value": {}
     },
     "additionalProperties": false
    }
   },
   "appearance": {
    "type": "object",
    "properties": {
     "textOverflow": {
      "type": "string",
      "enum": [
       "scroll",
       "truncate"
      ],
      "default": "scroll",
      "description": "Whether overflowing text should cause entire tree to scroll horizontally or to truncate text with an ellipsis"
     },
     "expandIcons": {
      "type": "object",
      "properties": {
       "collapsed": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Configuration for the tree icon used to represent a collapsed parent node."
       },
       "expanded": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Configuration for the tree icon used to represent a node with children displayed."
       },
       "empty": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Configuration for the tree icon used to represent a childless (terminal) node."
       }
      }
     },
     "defaultNodeIcons": {
      "type": "object",
      "properties": {
       "expanded": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Default icon displayed next to each expanded tree node's label"
       },
       "collapsed": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Default icon displayed next to each collapsed tree node's label"
       },
       "empty": {
        "$ref": "urn:ignition-schema:schemas/icon-schema.json",
        "description": "Default icon displayed next to each empty (terminal) tree node's label"
       }
      }
     },
     "selectedStyle": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "description": "Styles to apply to all selected nodes",
      "default": {
       "classes": ""
      }
     },
     "unselectedStyle": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
      "description": "Styles to apply to all unselected nodes",
      "default": {
       "classes": ""
      }
     },
     "rowHeight": {
      "type": "number",
      "description": "Height, in pixels, of each row/node in the tree",
      "default": 24
     }
    }
   },
   "style": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
   }
  },
  "example": {
   "items": [
    {
     "label": "Item 1",
     "expanded": true,
     "data": "I am string data for Item 1",
     "items": [
      {
       "label": "Child 1",
       "expanded": false,
       "data": {
        "someKey": "Information here."
       },
       "items": [
        {
         "label": "Grandchild 1",
         "items": [],
         "expanded": false,
         "data": {
          "things": [
           "one potato",
           "two potato",
           "three potato",
           "four",
           "boilem, mash em, put em in a stew"
          ]
         },
         "icon": {
          "path": "material/arrow_right",
          "color": "#869DB1",
          "style": {}
         }
        },
        {
         "label": "Grandchild 2",
         "items": [],
         "expanded": false,
         "data": 3.14159265359
        }
       ]
      }
     ]
    },
    {
     "label": "Item 2",
     "expanded": false,
     "items": [
      {
       "label": "Child of Item 2",
       "expanded": false,
       "items": [
        {
         "label": "Different Grandchild 1",
         "items": [],
         "expanded": false
        }
       ]
      }
     ],
     "data": [
      1,
      2,
      77,
      89,
      123
     ]
    }
   ],
   "selection": [],
   "selectionData": [],
   "interactable": true,
   "appearance": {
    "textOverflow": "scroll",
    "expandIcons": {
     "expanded": {
      "path": "material/arrow_drop_down",
      "color": ""
     },
     "collapsed": {
      "path": "material/arrow_right",
      "color": ""
     },
     "empty": {
      "path": "",
      "color": ""
     }
    },
    "defaultNodeIcons": {
     "expanded": {
      "path": "material/folder_open",
      "color": ""
     },
     "collapsed": {
      "path": "material/folder",
      "color": ""
     },
     "empty": {
      "path": "material/stop",
      "color": ""
     }
    },
    "selectedStyle": {
     "classes": ""
    },
    "unselectedStyle": {
     "classes": ""
    },
    "rowHeight": 24
   },
   "style": {
    "classes": ""
   }
  },
  "definitions": {
   "TreeNode": {
    "description": "Configuration for a single node of a tree.",
    "title": "Tree Node",
    "type": "object",
    "required": [
     "label",
     "items",
     "expanded"
    ],
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string",
      "description": "Text displayed for this item."
     },
     "expanded": {
      "type": "boolean",
      "description": "Whether this node is currently expanded in the tree."
     },
     "icon": {
      "$ref": "urn:ignition-schema:schemas/icon-schema.json",
      "description": "Optional custom icon to override default for this node"
     },
     "data": {
      "description": "Extra contextual information about this tree node."
     },
     "items": {
      "type": "array",
      "description": "An array of TreeNode objects, each of which represents a node in the tree.",
      "items": {
       "$ref": "#/definitions/TreeNode"
      }
     }
    },
    "default": {
     "label": "Item",
     "expanded": false,
     "data": {},
     "items": []
    }
   }
  }
 },
 "events": [
  {
   "name": "onItemClicked",
   "description": "Fired whenever an item is clicked on this tree.",
   "documentationUrl": "https://links.inductiveautomation.com/83-tree-component-events",
   "schema": {
    "type": "object",
    "properties": {
     "label": {
      "type": "string",
      "description": "Text to display for this option."
     },
     "data": {
      "description": "The value of the contextual 'data' object on the clicked node"
     },
     "itemPath": {
      "type": "array",
      "description": "A list containing the item indexes leading to the item that was clicked."
     }
    }
   }
  }
 ],
 "resources": [
  {
   "name": "perspective-components-css",
   "path": "/res/perspective/css/PerspectiveComponents.css",
   "type": "css"
  },
  {
   "name": "perspective-components-js",
   "path": "/res/perspective/js/PerspectiveComponents.js",
   "type": "js"
  }
 ]
}