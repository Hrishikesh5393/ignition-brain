           "property": "type",
           "equals": [
            "area",
            "bar"
           ]
          }
         },
         "radius": {
          "type": "number",
          "default": 2,
          "description": "The radius of the points.",
          "visibleWhen": {
           "property": "type",
           "equals": "scatter"
          }
