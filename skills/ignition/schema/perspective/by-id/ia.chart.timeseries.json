          "default": "curveLinear",
          "visibleWhen": {
           "property": "type",
           "equals": [
            "line",
            "area"
           ]
          }
         },
         "breakLine": {
          "type": "boolean",
          "default": true,
          "description": "If true, the line will be broken on either side of bad/missing data values. If false, bad/missing data values are removed and the adjoining points are connected.",
