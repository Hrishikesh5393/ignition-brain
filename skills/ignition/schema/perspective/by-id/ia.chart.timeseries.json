  "properties": {
   "enablePanZoom": {
    "type": "boolean",
    "description": "Allow the chart to be panned and zoomed.",
    "default": true
   },
   "autoGenerateSeriesNames": {
    "type": "boolean",
    "description": "Will auto generate series names if no name is provided.",
    "default": false
   },
   "series": {
    "type": "array",
    "description": "The raw data used to build the charts.",
    "items": {
     "type": "object",
     "required": [
      "name",
      "data"
     ],
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string",
       "description": "The name of the series.  A name must be provided if \"autoGenerateSeriesNames\" is false."
      },
      "data": {
       "description": "Data can be an object containing a 'time' entry and value entries. Each value entry must be labeled with the column name that it corresponds to. Data can also be an array containing value entries. Each value entry consists of a timestamp (which must be the FIRST value) and one or more values that were captured at that time. Finally, data can also be in the form of a dataset where the timestamp is the FIRST value per entry in the dataset.",
       "oneOf": [
        {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "time"
          ],
          "properties": {
           "time": {
            "type": [
             "string",
             "number"
            ],
            "description": "The timestamp when the data values were captured."
           }
          }
         }
        },
        {
         "type": "array",
         "items": {
          "type": "array",
          "description": "The first entry corresponds to the first column (timestamp), and each successive entry corresponds to the remaining column labels.",
          "items": {
           "type": [
            "number",
            "string"
           ]
          }
         }
        },
        {
         "type": "object",
         "properties": {
          "columns": {
           "type": "array"
          },
          "rowCount": {
           "type": "number"
          }
         }
        }
       ]
      }
     },
     "default": {
      "name": "",
      "data": []
     }
    },
    "example": [
     {
