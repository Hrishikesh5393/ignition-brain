{
 "id": "ia.display.alarmstatustable",
 "name": "Alarm Status Table",
 "palette": {
  "category": "display",
  "variants": [
   {
    "label": "Alarm Status Table",
    "tooltip": "Displays the current state of the alarm system. Can be configured to show active, cleared, and acknowledged events."
   }
  ]
 },
 "defaultMetaName": "AlarmStatusTable",
 "schema": {
  "type": "object",
  "properties": {
   "refreshRate": {
    "type": "number",
    "description": "The rate at which the table will poll for updates in milliseconds.",
    "default": 5000
   },
   "enableHeader": {
    "type": "boolean",
    "description": "Enable table header.",
    "default": true
   },
   "enableDetails": {
    "type": "boolean",
    "description": "Enable active events table details action.",
    "default": true
   },
   "enableAcknowledge": {
    "type": "boolean",
    "description": "Enable acknowledge action.",
    "default": true
   },
   "enableShelve": {
    "type": "boolean",
    "description": "Enable shelve action.",
    "default": true
   },
   "enableUnshelve": {
    "type": "boolean",
    "description": "Enable unshelve action.",
    "default": true
   },
   "toolbar": {
    "type": "object",
    "properties": {
     "enabled": {
      "type": "boolean",
      "description": "Enables the visibility of the table toolbar.",
      "default": true
     },
     "enableActiveTab": {
      "type": "boolean",
      "description": "Enables the visibility of the active events tab.",
      "default": true
     },
     "enableShelvedTab": {
      "type": "boolean",
      "description": "Enables the visibility of the shelved events tab.",
      "default": true
     },
     "enableFilter": {
      "type": "boolean",
      "description": "Enables the visibility of the text filter toggle.",
      "default": true
     },
     "toggleableFilter": {
      "type": "boolean",
      "description": "If false, the text filter will not require user interaction to open, and instead will remain open.",
      "visibleWhen": {
       "property": "enableFilter",
       "equals": true
      },
      "default": true
     },
     "enableFilterResults": {
      "type": "boolean",
      "description": "Enables the visibility of the filters results count message.",
      "default": true
     },
     "enablePreFilters": {
      "type": "boolean",
      "description": "Enables the visibility of the pre filter toggle.",
      "default": true
     },
     "enableConfiguration": {
      "type": "boolean",
      "description": "Enables the visibility of the configuration toggle.",
      "default": true
     }
    }
   },
   "shelvingTimes": {
    "type": "array",
    "description": "Available alarm shelving times in seconds.",
    "items": {
     "type": "number"
    },
    "default": [
     300,
     900,
     1800,
     3600,
     7200,
     14400
    ]
   },
   "responsive": {
    "type": "object",
    "description": "Responsive layout configuration.  Rows are converted to cards. While in responsive layout, disables or removes certain table features that are no longer applicable.",
    "properties": {
     "enabled": {
      "type": "boolean",
      "description": "Enables responsive layout.",
      "default": false
     },
     "breakpoint": {
      "type": "number",
      "description": "Width, in pixels, that triggers change in responsive layout.",
      "default": 500
     }
    }
   },
   "filters": {
    "type": "object",
    "properties": {
     "active": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string",
        "description": "The active alarm events filter text.",
        "default": ""
       },
       "states": {
        "type": "object",
        "description": "Pre filters for filter active alarm events.",
        "properties": {
         "activeUnacked": {
          "type": "boolean",
          "default": true
         },
         "activeAcked": {
          "type": "boolean",
          "default": true
         },
         "clearUnacked": {
          "type": "boolean",
          "default": true
         },
         "clearAcked": {
          "type": "boolean",
          "default": false
         }
        }
       },
       "priorities": {
        "type": "object",
        "description": "Alarm state priority pre-filters.",
        "properties": {
         "diagnostic": {
          "type": "boolean",
          "default": false
         },
         "low": {
          "type": "boolean",
          "default": true
         },
         "medium": {
          "type": "boolean",
          "default": true
         },
         "high": {
          "type": "boolean",
          "default": true
         },
         "critical": {
          "type": "boolean",
          "default": true
         }
        }
       },
       "conditions": {
        "type": "object",
        "description": "Gateway side alarm query conditions.",
        "properties": {
         "source": {
          "type": "string",
          "description": "Filter alarms by alarm source path. Specify multiple paths by separating them with commas. Supports the wildcard ✷",
          "default": ""
         },
         "displayPath": {
          "type": "string",
          "description": "Filter alarms by alarm display path, falling back to the source path if a custom display path isn't set. Specify multiple paths by separating them with commas. Supports the wildcard ✷.",
          "default": ""
         },
         "provider": {
          "type": "string",
          "description": "Filter alarms by alarm provider.",
          "default": ""
         }
        }
       },
       "results": {
        "type": "object",
        "description": "Active alarm filtering results configuration and data.",
        "properties": {
         "enabled": {
          "type": "boolean",
          "description": "Enable filter results to be written back to props.  Warning, doing so may cause performance decline.",
          "default": false
         },
         "data": {
          "type": "array",
          "description": "An array of objects representing the current filtered data. If enabled and active.",
          "items": {
           "type": "object",
           "properties": {}
          },
          "default": []
         }
        }
       }
      }
     },
     "shelved": {
      "type": "object",
      "properties": {
       "text": {
        "type": "string",
        "description": "The filter text for shelved alarms.",
        "default": ""
       },
       "results": {
        "type": "object",
        "description": "Shelved alarm filtering results configuration and data.",
        "properties": {
         "enabled": {
          "type": "boolean",
          "description": "Enable filter results to be written back to props.  Warning, doing so may cause performance decline.",
          "default": false
         },
         "data": {
          "type": "array",
          "description": "An array of objects representing the current filtered data. If enabled and active.",
          "items": {
           "type": "object",
           "properties": {}
          },
          "default": []
         }
        }
       }
      }
     }
    }
   },
   "selection": {
