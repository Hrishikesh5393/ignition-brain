{
 "id": "ia.symbol.sensor",
 "name": "Sensor",
 "palette": {
  "category": "symbols",
  "variants": [
   {
    "label": "Sensor",
    "tooltip": "A component that looks like a sensor."
   }
  ]
 },
 "defaultMetaName": "Sensor",
 "schema": {
  "type": "object",
  "properties": {
   "appearance": {
    "type": "string",
    "description": "auto uses the value of the Session Prop symbols.appearance if it exists, default is mimic.",
    "enum": [
     "auto",
     "p&id",
     "mimic",
     "simple"
    ],
    "default": "auto"
   },
   "animationSpeed": {
    "type": [
     "string",
     "number"
    ],
    "description": "The speed of animations as a percent. 0 turns off animations.",
    "default": "auto"
   },
   "state": {
    "type": "string",
    "format": "symbol-states",
    "default": "default"
   },
   "orientation": {
    "type": "string",
    "enum": [
     "top",
     "bottom",
     "left",
     "right"
    ],
    "default": "bottom"
   },
   "label": {
    "type": "object",
    "properties": {
     "text": {
      "type": [
       "string",
       "number",
       "boolean",
       "null",
       "object",
       "array"
      ],
      "default": "Sensor",
      "description": "Label to display as text",
      "example": "Sensor"
     },
     "location": {
      "type": "string",
      "enum": [
       "top",
       "bottom",
       "left",
       "right",
       "inside",
       "hidden"
      ],
      "default": "inside"
     },
     "justify": {
      "type": "string",
      "description": "Horizontal text alignment.",
      "enum": [
       "left",
       "center",
       "right",
       "auto"
      ],
      "visibleWhen": {
       "property": "location",
       "equals": [
        "top",
        "bottom",
        "left",
        "right"
       ]
      },
      "default": "center"
     },
     "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
     }
    }
   },
   "value": {
    "type": "object",
    "properties": {
     "text": {
      "type": [
       "string",
       "number",
       "boolean",
       "null",
       "object",
       "array"
      ],
      "default": "100%",
      "description": "Value to display as text",
      "example": "100%"
     },
     "location": {
      "type": "string",
      "enum": [
       "top",
       "bottom",
       "left",
       "right",
       "inside",
       "hidden"
      ],
      "default": "inside"
     },
     "justify": {
      "type": "string",
      "description": "Horizontal text alignment.",
      "enum": [
       "left",
       "center",
       "right"
      ],
      "visibleWhen": {
       "property": "location",
       "equals": [
        "top",
        "bottom",
        "left",
        "right"
       ]
      },
      "default": "center"
     },
     "style": {
      "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
     }
    }
   },
   "style": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
   }
  }
 },
 "resources": [
  {
   "name": "perspective-components-css",
   "path": "/res/perspective/css/PerspectiveComponents.css",
   "type": "css"
  },
  {
   "name": "perspective-components-js",
   "path": "/res/perspective/js/PerspectiveComponents.js",
   "type": "js"
  }
 ]
}