{
 "id": "ia.navigation.navlinks",
 "name": "Nav Links",
 "deprecated": true,
 "schema": {
  "type": "object",
  "properties": {
   "links": {
    "type": "array",
    "default": [],
    "items": {
     "type": "object",
     "properties": {
      "target": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "activeTextColor": {
       "type": "string",
       "description": "The color to render the text of the selected navigation item."
      },
      "activeUnderlineColor": {
       "type": "string",
       "description": "Color the active link will be underlined with."
      }
     }
    }
   },
   "activeTextStyle": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
    "default": {
     "borderBottom": "2px solid blue",
     "classes": "",
     "color": "blue"
    },
    "description": "Styling applied to the 'active' link text.  Is merged into (and overrides) 'activeTextStyle' properties."
   },
   "textStyle": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json",
    "default": {
     "classes": "",
     "cursor": "pointer",
     "marginRight": "1ex",
     "paddingBottom": "1ex",
     "fontWeight": 700,
     "color": "#ffffff",
     "textDecoration": "none"
    }
   },
   "style": {
    "$ref": "urn:ignition-schema:schemas/style-properties.schema.json"
   }
  }
 },
 "resources": [
  {
   "name": "perspective-components-css",
   "path": "/res/perspective/css/PerspectiveComponents.css",
   "type": "css"
  },
  {
   "name": "perspective-components-js",
   "path": "/res/perspective/js/PerspectiveComponents.js",
   "type": "js"
  }
 ]
}